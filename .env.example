# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit the real file.

# Get this from @BotFather on Telegram: /newbot, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# IANA timezone name used when no explicit timezone is given in a message
# (e.g. "America/New_York", "Asia/Manila", "Europe/London").
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TIMEZONE=Asia/Manila

# Only needed for the Vercel webhook deployment (api/index.py), not for
# local/Docker long-polling (bot/bot.py). Generate a random value yourself,
# e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value here, in Vercel's env vars, and in the setWebhook call
# -- see README's "Deploying on Vercel" section.
WEBHOOK_SECRET_TOKEN=

# Only needed for the Vercel webhook deployment. Shared secret for the
# /api/check-reminders endpoint -- an external scheduler (see README) hits
# that URL with ?token=<this value> to trigger due reminders. Generate the
# same way as WEBHOOK_SECRET_TOKEN, and keep the two values different.
CRON_SECRET=

# Only needed for the Vercel webhook deployment, for actual "message me
# later" reminders (reminders.py) -- a serverless function has no memory
# between requests, so reminders need somewhere durable to live until
# they're due. Add the "Upstash for Redis" integration from Vercel's
# Marketplace (Storage tab in your project); it injects these two
# automatically, no manual copy-paste needed on Vercel's side. For local
# testing, copy the same two values here from Vercel's Environment
# Variables page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
